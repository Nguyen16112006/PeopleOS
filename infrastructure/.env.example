# =====================================================================
# PeopleOS - Biến môi trường (sao chép thành infrastructure/.env)
# Mọi biến đều có giá trị mặc định trong docker-compose.yml; file này
# giúp bạn đổi mật khẩu trước khi triển khai thật.
# =====================================================================

# --- PostgreSQL (dùng chung cho Hasura, Keycloak, n8n) ---------------
POSTGRES_USER=peopleos
POSTGRES_PASSWORD=peopleos_pg_pass
POSTGRES_DB=peopleos

# --- Keycloak (Identity / SSO) ---------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_change_me
# URL mà TRÌNH DUYỆT dùng để truy cập Keycloak (phải khớp issuer của token)
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# --- Hasura (GraphQL / REST tự sinh) ----------------------------------
HASURA_ADMIN_SECRET=hasura_admin_secret_change_me

# --- MinIO (Object storage) --------------------------------------------
MINIO_ROOT_USER=peopleos_minio
MINIO_ROOT_PASSWORD=peopleos_minio_secret

# --- n8n (Workflow) ----------------------------------------------------
N8N_ENCRYPTION_KEY=change_me_n8n_encryption_key

# --- Khóa nội bộ để n8n gọi các API /api/internal/* của BFF ------------
INTERNAL_API_KEY=internal_key_change_me

# --- AI (Ollama + Qdrant) ----------------------------------------------
# Mô hình hội thoại (nhẹ, chạy được trên CPU). Có thể đổi sang qwen2.5:7b nếu đủ RAM.
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Mô hình embedding đa ngôn ngữ (hỗ trợ tiếng Việt)
OLLAMA_EMBED_MODEL=bge-m3

# --- Quét mã độc ClamAV ---------------------------------------------------
CLAMAV_ENABLED=true
# false = TỪ CHỐI tải lên khi ClamAV chưa sẵn sàng (an toàn). Đặt true chỉ khi demo trong lúc ClamAV đang tải chữ ký.
CLAMAV_FAIL_OPEN=false

# --- Sao lưu tự động -------------------------------------------------------
BACKUP_DIR=../backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7

# --- GitOps (tùy chọn, profile "gitops", máy chủ Linux) --------------------
HOST_REPO_PATH=/opt/peopleos
GITOPS_BRANCH=main
GITOPS_INTERVAL=60
