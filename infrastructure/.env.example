# =====================================================================
# PeopleOS - Biến môi trường (sao chép thành infrastructure/.env)
# Mọi biến đều có giá trị mặc định trong docker-compose.yml; file này
# giúp bạn đổi mật khẩu trước khi triển khai thật.
# =====================================================================

# --- PostgreSQL (dùng chung cho Hasura, Keycloak, Flowable) -----------
POSTGRES_USER=peopleos
POSTGRES_PASSWORD=peopleos_pg_pass
POSTGRES_DB=peopleos

# --- Keycloak (Identity / SSO) ---------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_change_me
# URL mà TRÌNH DUYỆT dùng để truy cập Keycloak (phải khớp issuer của token)
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# --- Hasura (GraphQL / REST tự sinh) ----------------------------------
HASURA_ADMIN_SECRET=hasura_admin_secret_change_me

# --- MinIO (Object storage) --------------------------------------------
MINIO_ROOT_USER=peopleos_minio
MINIO_ROOT_PASSWORD=peopleos_minio_secret

# --- Khóa nội bộ cho API tác vụ nền /api/internal/* của BFF ------------
INTERNAL_API_KEY=internal_key_change_me

# --- AI (Ollama + Qdrant) ----------------------------------------------
# Mô hình hội thoại (nhẹ, chạy được trên CPU), giấy phép Apache-2.0. Có thể đổi sang qwen2.5:7b (Apache-2.0) nếu đủ RAM.
# LƯU Ý GIẤY PHÉP: KHÔNG dùng qwen2.5:3b - bản 3B theo Qwen Research License (phi thương mại, không thuộc OSI).
OLLAMA_CHAT_MODEL=qwen2.5:1.5b

# Ghim phiên bản image (tái lập được). Kiểm tra tag tồn tại: docker manifest inspect <image>  (hoặc python scripts/preflight.py --check-images)
# OLLAMA_IMAGE=ollama/ollama:0.32.6
# MinIO: upstream ngừng phát hành image từ 10/2025; mặc định dùng bản mirror ghim phiên bản. Thay bằng image tự build từ mã nguồn nếu có.
# MINIO_IMAGE=scnd/minio-mirror:RELEASE.2025-09-07T16-13-09Z
# Mô hình embedding đa ngôn ngữ (hỗ trợ tiếng Việt)
OLLAMA_EMBED_MODEL=bge-m3

# --- Quét mã độc ClamAV ---------------------------------------------------
CLAMAV_ENABLED=true
# false = TỪ CHỐI tải lên khi ClamAV chưa sẵn sàng (an toàn). Đặt true chỉ khi demo trong lúc ClamAV đang tải chữ ký.
CLAMAV_FAIL_OPEN=false

# --- Sao lưu tự động -------------------------------------------------------
BACKUP_DIR=../backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7

# --- GitOps (tùy chọn, profile "gitops", máy chủ Linux) --------------------
HOST_REPO_PATH=/opt/peopleos
GITOPS_BRANCH=main
GITOPS_INTERVAL=60
