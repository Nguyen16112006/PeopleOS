# Bổ sung cho infrastructure/.env khi chạy docker-compose.paas.yml (ĐỔI mọi giá trị ở môi trường thật)
APISIX_ADMIN_KEY=change_me_admin_key
APISIX_KEYRING=edd1c9f0985e76a2
# Khóa Fernet mã hóa secret webhook:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PLATFORM_SECRET_KEY=
EVENT_DISPATCHER_SECRET=event_secret_change_me
PORTAL_ORIGIN=http://localhost:3100
# Chỉ khi chạy `python scripts/smoke-paas.py` (webhook tới máy host). Production: để false.
# ALLOW_PRIVATE_WEBHOOKS=true
# ALLOW_HTTP_WEBHOOKS=true
