{
  "realm": "peopleos",
  "enabled": true,
  "displayName": "PeopleOS",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 36000,
  "ssoSessionMaxLifespan": 72000,
  "roles": {
    "realm": [
      {
        "name": "employee",
        "description": "Nhân viên - cổng tự phục vụ (mọi tài khoản đều có)"
      },
      {
        "name": "manager",
        "description": "Quản lý - duyệt nghỉ phép/OT/chi phí cấp 1 của nhóm, đề xuất tăng lương, giao KPI"
      },
      {
        "name": "hr",
        "description": "Nhân sự - hồ sơ, hợp đồng, tuyển dụng, chốt công, thẩm định đề xuất"
      },
      {
        "name": "director",
        "description": "Giám đốc - duyệt cuối, dashboard điều hành, quản lý trực tiếp các Quản lý"
      },
      {
        "name": "accountant",
        "description": "Kế toán - tính lương, chi trả, thuế TNCN, BHXH, tạm ứng/chi phí, báo cáo tài chính năm"
      },
      {
        "name": "sysadmin",
        "description": "Quản trị kỹ thuật - tài khoản, phân quyền, cấu hình, audit log; không xem dữ liệu lương/hợp đồng"
      }
    ]
  },
  "clients": [
    {
      "clientId": "people-workspace",
      "name": "People Workspace",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ]
    }
  ],
