    {
      "parameters": {
        "jsCode": "// Payload từ BFF: { request_id, employee_name, employee_user_id, manager_user_id, leave_type, start_date, end_date, days }\nconst b = $input.first().json.body;\nconst items = [];\n// Người duyệt: quản lý trực tiếp, nếu chưa có tài khoản thì chuyển cho HR\nconst target = b.manager_user_id ? { user_id: b.manager_user_id } : { role: 'hr' };\nitems.push({ json: { ...target, title: 'Đơn nghỉ phép chờ duyệt',\n  message: `${b.employee_name} xin nghỉ ${b.days} ngày (${b.start_date} → ${b.end_date}).`,\n  ref_type: 'leave_request', ref_id: b.request_id, kind: 'leave.pending' } });\nif (b.employee_user_id) items.push({ json: { user_id: b.employee_user_id, title: 'Đã gửi đơn nghỉ phép',\n  message: 'Đơn của bạn đang chờ quản lý duyệt.', ref_type: 'leave_request', ref_id: b.request_id, kind: 'leave.submitted' } });\nreturn items;"
      },
      "id": "2038dac4-9638-5899-a203-7136c3e1afa4",
