<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://peopleos.dev/workflows">
  <process id="leave-decision" name="PeopleOS - Kết quả duyệt nghỉ phép" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="startToNotify" sourceRef="start" targetRef="handleLeaveDecision" />
    <serviceTask id="handleLeaveDecision" name="Thông báo kết quả cho nhân viên"
                 flowable:delegateExpression="${workflowDelegate}" />
    <endEvent id="end" />
    <sequenceFlow id="notifyToEnd" sourceRef="handleLeaveDecision" targetRef="end" />
  </process>
</definitions>
